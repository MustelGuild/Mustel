// Mustel — exemplo de arquivo de configuração (JSONC: comentários são aceitos)
//
// Copie para:
//   Windows: %APPDATA%\Mustel\mustel.jsonc
//   Linux:   $XDG_CONFIG_HOME/Mustel/mustel.jsonc (ou ~/.config/Mustel/mustel.jsonc)
//   macOS:   ~/Library/Application Support/Mustel/mustel.jsonc
//
// Passwords are NOT stored here: they live in the system keyring
// (Windows Credential Manager / macOS Keychain / Secret Service), set via
// `mustel settings db-servers set-password <name>`.
{
  // PostgreSQL servers used by `query run`, `database` and `settings`
  "servers": [
    {
      "name": "dev",
      "host": "localhost",
      "port": 5432,
      "username": "postgres",
      "databases": ["mydb", "app_dev"],
      "sslMode": "Prefer",
      "timeout": 30,
      "maxParallelism": 4
    },
    {
      "name": "prod",
      "host": "prod-db.company.com",
      "port": 5432,
      "username": "readonly",
      "fetchAllDatabases": true,
      "excludePatterns": ["template*", "postgres"],
      "sslMode": "Require",
      "timeout": 30,
      "maxParallelism": 2
    }
  ],

  // Defaults applied when CLI flags do not override them
  "defaults": {
    "outputDirectory": "./results",
    "requireConfirmation": true,
    "maxParallelism": 4
  },

  // Window preferences (Settings tab). Only what you changed appears here: an
  // untouched installation has no "gui" section at all.
  "gui": {
    // "system" follows the operating system theme (default, and therefore
    // omitted from the file), or pin it with "light" / "dark".
    "theme": "dark",
    // Window font families; omit to use the embedded ones.
    "interfaceFont": "Segoe UI",
    "editorFont": "Fira Code",
    // Uniform text scale, 0.80 to 1.25 (default 1.0).
    "fontScale": 1.1,
    // Database list pagination in the Query tab (off by default).
    "selectionList": { "paginate": false, "pageSize": 50 },
    // Saved selection queries: [{ "name", "server", "database", "sql" }].
    "selections": [],
    // Queries you pick in the Query tab to load into the editor:
    // [{ "name", "sql" }].
    "savedQueries": [
      { "name": "Sample: first 100 rows", "sql": "SELECT * FROM my_table LIMIT 100" }
    ]
  }
}
