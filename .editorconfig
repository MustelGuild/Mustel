root = true

# Convenções de editor do Mustel (projeto Rust).
# Formatação de Rust é responsabilidade do `rustfmt` (ver `rustfmt.toml`); aqui ficam só as regras
# que o rustfmt não cobre.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.toml]
indent_size = 2

[Makefile]
indent_style = tab
