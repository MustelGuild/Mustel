# Contrato congelado: o baseline (`fixtures/baseline/`) é **versionado**; estes não são.
fixtures/bin/
fixtures/workdir/
fixtures/reports/

# Saída das execuções de `query run` (o default do cadastro é `./results`)
results/

# Pacotes gerados por `publish.ps1` / `publish.sh`
packaging/

# SBOM por crate que o `cargo cyclonedx` escreve ao lado de cada Cargo.toml; a raiz guarda o
# inventário publicado (`sbom.cdx.json`), versionado.
crates/*/sbom.cdx.json

# Editor / SO
.idea/
.vscode/*
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# Smoke headless: saída, capturas e target do container
smoke/out/
